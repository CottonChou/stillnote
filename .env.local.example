# Copy to .env.local and never commit that file.

# Cloudflare
# Find the account ID with `bunx wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=

# User API Token for `bun run deploy:builds:setup`; do not use an Account API Token.
# Required permissions:
#   - Workers Builds Configuration: Edit
#   - Workers Scripts: Read
STILLNOTE_BUILDS_API_TOKEN=

STILLNOTE_WORKER_NAME=stillnote
STILLNOTE_WORKERS_DEV=true
# Optional for local CLI deployments. CI deployments discover the URL from Wrangler output.
STILLNOTE_DEPLOYMENT_URL=

# Storage
STILLNOTE_D1_DATABASE_NAME=stillnote
# Use the database_id returned by Cloudflare.
STILLNOTE_D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
STILLNOTE_R2_BUCKET_NAME=stillnote-resources
# Optional bucket for isolated preview/dev attachments.
STILLNOTE_R2_PREVIEW_BUCKET_NAME=stillnote-resources-preview

# Authentication
# Initial login credentials; the password is uploaded as a Worker Secret.
STILLNOTE_AUTH_USERNAME=admin
STILLNOTE_AUTH_PASSWORD=
# Allowed range: 1-400 days.
STILLNOTE_SESSION_TTL_DAYS=400
# Portable application-level login protection. These values work in both D1 and SQLite.
# The defaults are 5 attempts per username / 15 minutes and 30 attempts per IP / 5 minutes.
STILLNOTE_AUTH_LOGIN_WINDOW_SECONDS=900
STILLNOTE_AUTH_LOGIN_USERNAME_MAX_ATTEMPTS=5
STILLNOTE_AUTH_LOGIN_USERNAME_COOLDOWN_SECONDS=900
STILLNOTE_AUTH_LOGIN_IP_MAX_ATTEMPTS=30
STILLNOTE_AUTH_LOGIN_IP_COOLDOWN_SECONDS=300

# Demo mode
# Seeds sample content and periodically resets it; intended for public demos only.
STILLNOTE_DEMO_MODE=false
# UTC Cron schedule, used only when demo mode is enabled.
# Default: 0 19 * * * = every day at 03:00 China Standard Time (UTC+8).
STILLNOTE_DEMO_RESET_CRON=0 19 * * *

# Routing
# Example: notes.example.com
STILLNOTE_CUSTOM_DOMAIN=
# Optional full route pattern; otherwise the custom domain is used.
STILLNOTE_ROUTE_PATTERN=

# Local frontend
VITE_API_BASE_URL=http://127.0.0.1:8787

# Self-hosted Bun runtime (used by `bun run start:self-hosted`).
# The data directory should be mounted as the persistent Docker/NAS volume.
STILLNOTE_DATA_DIR=.stillnote-data
STILLNOTE_SQLITE_FILE=.stillnote-data/stillnote.sqlite
STILLNOTE_RESOURCES_DIR=.stillnote-data/resources
STILLNOTE_PORT=8787
# Set to `s3` for AWS S3, MinIO, R2, OSS, or COS through the S3-compatible API.
STILLNOTE_STORAGE_BACKEND=local
STILLNOTE_S3_ENDPOINT=
STILLNOTE_S3_REGION=us-east-1
STILLNOTE_S3_BUCKET=
STILLNOTE_S3_ACCESS_KEY_ID=
STILLNOTE_S3_SECRET_ACCESS_KEY=
STILLNOTE_S3_FORCE_PATH_STYLE=false

# Multi-instance deployments
# Select remote instances per command, for example:
# STILLNOTE_INSTANCE=prod bun run dev:remote
# Instance-specific `STILLNOTE_<NAME>_*` values override the generic values above.
