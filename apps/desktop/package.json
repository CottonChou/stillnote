{
  "name": "@stillnote/desktop",
  "version": "2.18.0",
  "desktopName": "StillNote",
  "private": true,
  "description": "Native StillNote desktop client",
  "author": "StillNote contributors",
  "type": "module",
  "main": "src/main/index.mjs",
  "scripts": {
    "dev": "bun scripts/build-backup-worker.mjs && electron .",
    "start": "bun scripts/build-backup-worker.mjs && electron .",
    "dist": "electron-builder --config electron-builder.yml",
    "verify-origin-migration": "electron ../../scripts/renderer-origin-verifier"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.5.1",
    "@stillnote/public-network": "workspace:*",
    "croner": "^10.0.1",
    "electron-updater": "^6.6.2",
    "fflate": "0.8.3",
    "npm": "11.21.0",
    "zod": "4.6.6"
  }
}
